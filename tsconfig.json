{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-academy2-dev/types/**/*.ts",
    ".next-academy2-dev/dev/types/**/*.ts",
    ".next-academy2-build/types/**/*.ts",
    ".next-academy2-build/dev/types/**/*.ts",
    ".next-academy2-dev-recovery/types/**/*.ts",
    ".next-academy2-dev-recovery/dev/types/**/*.ts",
    ".next-academy2-predeploy/types/**/*.ts",
    ".next-academy2-predeploy/dev/types/**/*.ts",
    ".next-academy2-dev-full-20260928/types/**/*.ts",
    ".next-academy2-dev-full-20260928/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "supabase/functions"
  ]
}
